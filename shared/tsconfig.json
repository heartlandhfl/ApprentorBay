{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": true
  },
  "include": [
    "index.ts",
    "types.ts",
    "learningContractMachine.ts",
    "legal.ts",
    "legal/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
