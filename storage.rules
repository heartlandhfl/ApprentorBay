rules_version = '2';

// Deny-by-default Firebase Storage rules for ApprentorBay.
// Evidence objects are private. They never use /portfolios (public read).
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'admin'
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || userDoc(request.auth.uid).accountStatus == 'active'
        );
    }

    function accountCanSignIn() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || userDoc(request.auth.uid).accountStatus == 'active'
          || userDoc(request.auth.uid).accountStatus == 'restricted'
        );
    }

    function accountParticipates() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || userDoc(request.auth.uid).accountStatus == 'active'
        );
    }

    function contractDoc(contractId) {
      return firestore.get(/databases/(default)/documents/learningContracts/$(contractId));
    }

    function isContractMember(contractId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/learningContracts/$(contractId))
        && (
          contractDoc(contractId).data.learnerId == request.auth.uid
          || contractDoc(contractId).data.mentorId == request.auth.uid
          || isAdmin()
        );
    }

    function isContractLearner(contractId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/learningContracts/$(contractId))
        && contractDoc(contractId).data.learnerId == request.auth.uid;
    }

    function isValidImageWrite() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
        ];
    }

    function isValidEvidenceWrite() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/pdf',
          'text/plain',
        ];
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /profile-photos/{slug}/{fileId} {
      allow read: if true;
      allow create, update: if accountCanSignIn()
        && userDoc(request.auth.uid).profileSlug == slug
        && isValidImageWrite();
      allow delete: if (
        isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).profileSlug == slug
      ) || isAdmin();
    }

    // Legacy public folder. New photos use profile-photos. Writes stay denied.
    match /portfolios/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Private evidence: pairing members and admins may read.
    // Only the contract learner may upload under their own uid segment.
    match /evidence/{contractId}/{milestoneId}/{userId}/{fileId} {
      allow read: if isContractMember(contractId);
      allow create, update: if accountParticipates()
        && isContractLearner(contractId)
        && request.auth.uid == userId
        && isValidEvidenceWrite();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
