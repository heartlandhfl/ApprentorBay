rules_version = '2';

// Deny-by-default. Messaging is scoped to active relationship members.
// Never ship `allow read, write: if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'admin';
    }

    function isLearner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'learner';
    }

    function relationshipPath(relationshipId) {
      return /databases/$(database)/documents/mentorshipRelationships/$(relationshipId);
    }

    function isActiveRelationshipMember(relationshipId) {
      return isSignedIn()
        && exists(relationshipPath(relationshipId))
        && get(relationshipPath(relationshipId)).data.status == 'active'
        && (
          get(relationshipPath(relationshipId)).data.learnerId == request.auth.uid
          || get(relationshipPath(relationshipId)).data.mentorId == request.auth.uid
        );
    }

    function isPairingMember() {
      return isSignedIn() && (
        resource.data.learnerId == request.auth.uid
        || resource.data.mentorId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['learner', 'mentor'];
      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /learnerProfiles/{profileId} {
      allow read: if resource.data.public == true || isOwner(profileId) || isAdmin();
      allow create: if isOwner(profileId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(profileId) || isAdmin();
      allow delete: if false;
    }

    match /mentorProfiles/{profileId} {
      allow read: if resource.data.public == true || isOwner(profileId) || isAdmin();
      allow create: if isOwner(profileId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending';
      allow update: if isAdmin()
        || (
          isOwner(profileId)
          && request.resource.data.verificationStatus == resource.data.verificationStatus
        );
      allow delete: if false;
    }

    match /mentorshipApplications/{applicationId} {
      allow read: if isPairingMember() || isAdmin();
      allow create: if isLearner()
        && request.resource.data.learnerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.mentorId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && exists(/databases/$(database)/documents/mentorProfiles/$(request.resource.data.mentorId));
      allow update: if resource.data.mentorId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.learnerId == resource.data.learnerId
        && request.resource.data.mentorId == resource.data.mentorId
        && request.resource.data.message == resource.data.message;
      allow delete: if false;
    }

    match /mentorshipRelationships/{relationshipId} {
      allow read: if isPairingMember() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.mentorId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.learnerId is string
        && request.resource.data.learnerId != request.auth.uid;
      allow update: if isPairingMember()
        && request.resource.data.learnerId == resource.data.learnerId
        && request.resource.data.mentorId == resource.data.mentorId
        && request.resource.data.status in ['active', 'ended'];
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isActiveRelationshipMember(resource.data.relationshipId);
      allow create: if isActiveRelationshipMember(request.resource.data.relationshipId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /mentorships/{mentorshipId} {
      allow read: if isPairingMember() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.learnerId == request.auth.uid;
      allow update: if isPairingMember() || isAdmin();
      allow delete: if false;
    }

    match /learningContracts/{contractId} {
      allow read: if isPairingMember() || isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
