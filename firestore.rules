rules_version = '2';

// Deny-by-default. Pairing workspace reads are for members (or admin).
// Relationship create/update and application decisions go through Express.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'admin'
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || userDoc(request.auth.uid).accountStatus == 'active'
        );
    }

    function isLearner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'learner';
    }

    // Caller-only gets. Safe on list rules because they do not vary by result row.
    function callerExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerAccountStatus() {
      return userDoc(request.auth.uid).accountStatus;
    }

    function accountCanSignIn() {
      return callerExists()
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || callerAccountStatus() == 'active'
          || callerAccountStatus() == 'restricted'
        );
    }

    function accountParticipates() {
      return callerExists()
        && userDoc(request.auth.uid).active != false
        && (
          !('accountStatus' in userDoc(request.auth.uid))
          || callerAccountStatus() == 'active'
        );
    }

    function userParticipates(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.active != false
        && (
          !('accountStatus' in get(/databases/$(database)/documents/users/$(uid)).data)
          || get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == 'active'
        );
    }

    function relationshipPath(relationshipId) {
      return /databases/$(database)/documents/mentorshipRelationships/$(relationshipId);
    }

    function relationshipData(relationshipId) {
      return get(relationshipPath(relationshipId)).data;
    }

    function isRelationshipMember(relationshipId) {
      return isSignedIn()
        && exists(relationshipPath(relationshipId))
        && (
          relationshipData(relationshipId).learnerId == request.auth.uid
          || relationshipData(relationshipId).mentorId == request.auth.uid
        );
    }

    function isActiveRelationshipMember(relationshipId) {
      return isRelationshipMember(relationshipId)
        && relationshipData(relationshipId).status == 'active';
    }

    function isPairedWith(profileId) {
      return isSignedIn() && (
        exists(relationshipPath(request.auth.uid + '_' + profileId))
        || exists(relationshipPath(profileId + '_' + request.auth.uid))
      );
    }

    function isPairingMember() {
      return isSignedIn() && (
        resource.data.learnerId == request.auth.uid
        || resource.data.mentorId == request.auth.uid
      );
    }

    function mentorIsApproved(mentorId) {
      return exists(/databases/$(database)/documents/mentorProfiles/$(mentorId))
        && get(/databases/$(database)/documents/mentorProfiles/$(mentorId)).data.verificationStatus == 'approved';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['learner', 'mentor']
        && request.resource.data.active == true
        && (
          !('accountStatus' in request.resource.data)
          || request.resource.data.accountStatus == 'active'
        )
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() > 0
        && request.resource.data.termsAcceptedAt is string
        && request.resource.data.termsAcceptedAt.size() > 0
        && (
          !('profileSlug' in request.resource.data)
          || request.resource.data.profileSlug == null
        );
      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && (
          !('accountStatus' in request.resource.data)
          || request.resource.data.accountStatus == resource.data.accountStatus
          || (
            !('accountStatus' in resource.data)
            && request.resource.data.accountStatus == 'active'
          )
        )
        && (
          request.resource.data.termsVersion == resource.data.termsVersion
          || request.resource.data.termsVersion is string
        )
        && (
          !('termsAccepted' in request.resource.data)
          || request.resource.data.termsAccepted == true
        )
        && (
          !('profileSlug' in request.resource.data)
          || request.resource.data.profileSlug == resource.data.profileSlug
        );
      allow delete: if false;
    }

    match /learnerProfiles/{profileId} {
      allow read: if isOwner(profileId) || isAdmin() || isPairedWith(profileId);
      allow create: if isOwner(profileId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /mentorProfiles/{profileId} {
      allow read: if isOwner(profileId) || isAdmin() || isPairedWith(profileId);
      allow create: if isOwner(profileId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending';
      allow update, delete: if false;
    }

    function ownsPublicSlug(slug) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).profileSlug == slug;
    }

    match /publicProfiles/{slug} {
      allow read: if resource.data.published == true || isAdmin() || ownsPublicSlug(slug);
      allow create, update, delete: if false;
    }

    match /profileSlugs/{slug} {
      allow read, write: if false;
    }

    match /mentorshipApplications/{applicationId} {
      allow read: if isPairingMember() || isAdmin();
      allow create: if isLearner()
        && accountParticipates()
        && request.resource.data.learnerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.mentorId is string
        && request.resource.data.mentorId != request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && mentorIsApproved(request.resource.data.mentorId)
        && userParticipates(request.resource.data.mentorId);
      allow update, delete: if false;
    }

    match /mentorshipRelationships/{relationshipId} {
      allow read: if isPairingMember() || isAdmin();
      allow create, update, delete: if false;
    }

    match /mentorshipBookings/{bookingId} {
      allow read: if isPairingMember() || isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentIntents/{paymentIntentId} {
      allow read: if isPairingMember() || isAdmin();
      allow create, update, delete: if false;
    }

    match /checkoutSessions/{checkoutSessionId} {
      allow read: if resource.data.learnerId == request.auth.uid || isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentRefunds/{refundId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentWebhookDedup/{dedupId} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read: if isRelationshipMember(resource.data.relationshipId) || isAdmin();
      allow create: if accountParticipates()
        && isActiveRelationshipMember(request.resource.data.relationshipId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /mentorships/{mentorshipId} {
      allow read, write: if false;
    }

    match /learningContracts/{contractId} {
      allow get: if isPairingMember() || isAdmin();
      allow list: if isRelationshipMember(resource.data.relationshipId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /mentorshipSessions/{sessionId} {
      allow read: if isActiveRelationshipMember(resource.data.relationshipId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Public showcase records are projected onto publicProfiles. Direct reads
    // stay pairing/admin so visitor queries cannot harvest Firebase UIDs.
    match /showcases/{showcaseId} {
      allow read: if isPairingMember() || isAdmin();
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Operator list maintained in the Firebase console. Clients cannot write it.
    // Express copies these into users/{uid} with role == admin.
    match /admins/{adminId} {
      allow read: if isSignedIn()
        && (request.auth.uid == adminId || request.auth.uid == resource.data.uid);
      allow create, update, delete: if false;
    }

    match /supportIssues/{issueId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if accountCanSignIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 8;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
