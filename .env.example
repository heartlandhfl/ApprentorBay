# Client (Vite — exposed to the browser)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true

# Jitsi Meet (optional — defaults to meet.jit.si for MVP)
# VITE_JITSI_DOMAIN=meet.jit.si

# Server (Express)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
USE_FIREBASE_EMULATOR=true

# Jitsi Meet domain returned by POST /api/sessions/:id/join (optional)
# JITSI_DOMAIN=meet.jit.si
# Production JaaS (later): set JITSI_DOMAIN=8x8.vc, JITSI_APP_ID, and sign JWTs server-side.

# Seeded admin (emulator / local only — never a production secret)
SEED_ADMIN_EMAIL=admin@apprentorbay.test
SEED_ADMIN_PASSWORD=ApprentorBayAdmin-2026

# Server Firebase Admin (required when not using emulators)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Hostinger corrupts PEM newlines (OpenSSL: DECODER routines::unsupported).
# Prefer one-line base64 of the downloaded service-account JSON:
#   node scripts/encode-firebase-key.mjs ./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Local / emulator-adjacent only — do not paste a raw PEM on Hostinger:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Payments (Stripe — USD only)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Marketplace commission in basis points (1500 = 15.00%)
PLATFORM_FEE_BPS=1500
# Optional client publishable key for future embedded checkout UI
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- Production (Hostinger Node.js web app) ---
# Set these in hPanel → website → Environment variables (needed at BUILD and runtime).
# VITE_* values are baked into the client during `npm run build`.
# VITE_USE_FIREBASE_EMULATOR=false
# USE_FIREBASE_EMULATOR=false
# CLIENT_ORIGIN=https://apprentorbay.com
# SEED_ADMIN_EMAIL=you@yourdomain.com
# SEED_ADMIN_PASSWORD=choose-a-unique-production-password
# On first boot with no admin user, Express creates that account.
# After you can sign in at /login, you may remove these two vars.
