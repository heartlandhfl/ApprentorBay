# Client (Vite — exposed to the browser)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true

# Server (Express)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
USE_FIREBASE_EMULATOR=true

# Seeded admin (emulator / local only — never a production secret)
SEED_ADMIN_EMAIL=admin@apprentorbay.test
SEED_ADMIN_PASSWORD=ApprentorBayAdmin-2026

# Server Firebase Admin (required when not using emulators)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Prefer the raw private_key value from the service-account JSON.
# Hostinger often strips newlines; one line is fine — the server rebuilds PEM.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Optional: paste the entire service-account JSON instead of the three fields above.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# --- Production (Hostinger Node.js web app) ---
# Set these in hPanel → website → Environment variables (needed at BUILD and runtime).
# VITE_* values are baked into the client during `npm run build`.
# VITE_USE_FIREBASE_EMULATOR=false
# USE_FIREBASE_EMULATOR=false
# CLIENT_ORIGIN=https://apprentorbay.com
# SEED_ADMIN_EMAIL=you@yourdomain.com
# SEED_ADMIN_PASSWORD=choose-a-unique-production-password
# On first boot with no admin user, Express creates that account.
# After you can sign in at /login, you may remove these two vars.
